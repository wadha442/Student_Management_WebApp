<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
    http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
	id="WebApp_ID" version="3.1">

	<display-name>StudentManagementWebApp</display-name>


	<!-- Student Servlet -->

	<servlet>
		<servlet-name>AddStudentServlet</servlet-name>
		<servlet-class>app.studentmanagment.controller.AddStudentServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>AddStudentServlet</servlet-name>
		<url-pattern>/addStudent</url-pattern>
	</servlet-mapping>

	<servlet>

		<servlet-name>SearchStudentServlet</servlet-name>

		<servlet-class>app.studentmanagment.controller.SearchStudentServlet</servlet-class>

	</servlet>


	<servlet-mapping>

		<servlet-name>SearchStudentServlet</servlet-name>

		<url-pattern>/searchStudent</url-pattern>

	</servlet-mapping>

	<servlet>
		<servlet-name>ShowStudentsServlet</servlet-name>

		<servlet-class>app.studentmanagment.controller.ShowStudentsServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>ShowStudentsServlet</servlet-name>

		<url-pattern>/showStudents</url-pattern>
	</servlet-mapping>
	<!-- Welcome Page -->

	<welcome-file-list>

		<welcome-file>index.html</welcome-file>

		<welcome-file>index.jsp</welcome-file>

		<welcome-file>index.htm</welcome-file>

		<welcome-file>index.xhtml</welcome-file>

		<welcome-file>default.html</welcome-file>

		<welcome-file>default.jsp</welcome-file>

		<welcome-file>default.htm</welcome-file>

		<welcome-file>default.xhtml</welcome-file>

	</welcome-file-list>

</web-app>